{
  "name": "fluidpath-studio",
  "description": "FluidPath Studio — 液路动态示意图编辑器（Electron + React）",
  "author": "FluidPath Studio",
  "private": true,
  "version": "1.20.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "smoke": "npm run build && electron scripts/smoke.cjs",
    "smoke:multiwindow": "npm run build && electron scripts/multiwindow-smoke.cjs",
    "verify:asar": "electron scripts/verify-asar.cjs",
    "start": "npm run build && electron .",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac dir",
    "check:diag": "node scripts/check-diagram.mjs"
  },
  "build": {
    "appId": "com.fluidpath.studio",
    "productName": "FluidPath Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "iconSize": 100
    }
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
